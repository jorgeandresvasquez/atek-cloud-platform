{
  "name": "atek-cloud-platform",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "local/*",
    "tests"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c auto,auto \"pnpm --filter @apps/api dev\" \"pnpm --filter @apps/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "db:generate": "dotenv -e .env -- pnpm --filter @atek/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @atek/db migrate:dev",
    "db:deploy": "dotenv -e .env -- pnpm --filter @atek/db migrate:deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter @atek/db seed",
    "bootstrap:local": "pnpm db:generate && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.3",
    "concurrently": "^9.0.1",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
